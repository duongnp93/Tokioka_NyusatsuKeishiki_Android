<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:background="#333333"
    android:orientation="vertical" 
    android:noHistory="true"
    >

    <RelativeLayout
        android:id="@+id/blockHeader"
     	android:layout_width="match_parent"
     	android:layout_height="48.5dp"
     	android:background="@drawable/common_bar_bg">
     	
		<ImageButton
		    android:id="@+id/btnBack"
		    android:layout_width="56dp"
		    android:layout_height="36dp"
		    android:layout_alignParentLeft="true"
		    android:layout_centerVertical="true"
		    android:layout_marginLeft="10dp"
		    android:background="@null"
		    android:contentDescription="@string/app_name"
		    android:scaleType="fitCenter"
		    android:src="@drawable/common_back_button_style" />
        
       <TextView 
           android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/product_search_screen_title"/>
        
    </RelativeLayout>
<!--
    <rasis.realluceauction.view.PlacesView
            android:id="@+id/blockPlace"
            android:layout_below="@+id/blockHeader"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="19dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
    </rasis.realluceauction.view.PlacesView>
-->
    
    <RelativeLayout         
        android:id="@+id/blockSearchInput"
     	android:layout_width="match_parent"
     	android:layout_height="132dp"
     	android:background="@drawable/search_input_bg"
     	android:layout_centerHorizontal="true"
     	android:layout_marginLeft="17.5dp"
     	android:layout_marginRight="17.5dp"
     	android:layout_marginTop="23dp"
     	android:layout_below="@+id/blockHeader"
     	>
        
	        <TextView
	            android:id="@+id/lblSearchByProduct"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_alignParentLeft="true"
	            android:layout_alignParentTop="true"
	            android:layout_marginLeft="14dp"
	            android:layout_marginTop="10dp"
	            android:text="@string/product_search_search_by_product"
	            android:textColor="@android:color/white"
	            android:textSize="20sp" />
	        
	     	<EditText
	     	    android:id="@+id/txtProductNo"
	     	    android:layout_width="match_parent"
	     	    android:layout_height="wrap_content"
	     	    android:layout_alignParentLeft="true"
	     	    android:layout_marginLeft="14dp"
	     	    android:layout_marginRight="10dp"
	     	    android:layout_marginTop="65dp"
	     	    android:layout_toLeftOf="@+id/btnSearch"
	     	    android:background="@drawable/textbox_bg"
	     	    android:textColor="#000000"
	     	    android:cursorVisible="true"
	     	    android:focusableInTouchMode="true"
	     	    android:imeOptions="actionSearch"
	     	    android:inputType="number"
				android:maxLength="4"
	     	    android:paddingLeft="5dp"
	     	    android:paddingRight="5dp" 
	     	    android:hint="@string/conrner_search_product_no_hint"/>
	        
	   		<ImageButton
	   		    android:id="@+id/btnSearch"
	   		    android:layout_width="91dp"
	   		    android:layout_height="41.5dp"
	   		    android:layout_alignParentRight="true"
	   		    android:layout_marginRight="14dp"
	   		    android:layout_marginTop="65dp"
	   		    android:background="@null"
	   		    android:contentDescription="@string/product_search_screen_title"
	   		    android:scaleType="fitCenter"
	   		    android:src="@drawable/search_search_button_style" />
	        
    </RelativeLayout>    
    
    
    
    <include 
        layout="@layout/layout_main_menu"            
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@null"
		android:layout_alignParentBottom="true"/>

</RelativeLayout>