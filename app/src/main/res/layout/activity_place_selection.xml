<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:background="#333333"
    android:orientation="vertical" 
    android:noHistory="true">

    <RelativeLayout
        android:id="@+id/blockHeader"
     	android:layout_width="match_parent"
     	android:layout_height="48.5dp"
     	android:background="@drawable/common_bar_bg">
     	
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" 
            android:contentDescription = "@string/place_selection_screen_title"/>
        
       <TextView 
           android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/place_selection_screen_title"/>
        
    </RelativeLayout>

    
	<ListView
        android:id="@+id/lvPlaces"
        android:layout_width ="match_parent"
        android:layout_height ="match_parent"
        android:layout_below="@+id/blockHeader"
        android:layout_margin="20dp"
        android:background="#333333"
        android:dividerHeight="1dp"
        android:divider="#333333"
        >
        
	</ListView>
    
</RelativeLayout>