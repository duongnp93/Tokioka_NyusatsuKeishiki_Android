<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="#ffffff"
	android:orientation="vertical"
	android:noHistory="true"
	android:keepScreenOn="true">

    	<RelativeLayout
			android:id="@+id/blockHeader"
			android:layout_width="match_parent"
			android:layout_height="40dp"
			android:background="#024AA6">

			<ImageButton
				android:id="@+id/btnBack"
				android:layout_width="79dp"
				android:layout_height="25dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:layout_marginLeft="-17dp"
				android:background="@null"
				android:scaleType="fitCenter"
				android:src="@drawable/common_back_button_style"
				android:contentDescription = "@string/auction_title"
				/>

			<TextView android:id="@+id/boxNoTxt"
				android:layout_toRightOf="@+id/btnBack"
				android:layout_toLeftOf="@+id/btnMode"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:textSize="16dp"
				android:textColor="@android:color/white"
				/>

			<ImageButton
				android:id="@+id/btnMode"
				android:layout_width="79dp"
				android:layout_height="36dp"
				android:layout_alignParentRight="true"
				android:layout_centerVertical="true"
				android:layout_marginRight="10dp"
				android:background="@null"
				android:scaleType="fitCenter"
				android:src="@drawable/auction_mode_watch_button_style"
				android:contentDescription = "@string/auction_title"
				/>

    	</RelativeLayout>

		<RelativeLayout
			android:id="@+id/blockDeactivedLanes"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_below="@+id/blockHeader"
			android:background="@android:color/transparent"
			android:paddingLeft="0dp"
			android:paddingRight="0dp">

			<RelativeLayout
				android:id="@+id/blockLaneImageBorder"
				android:layout_width="match_parent"
				android:layout_height="210dp"
				android:background="@android:color/transparent"
				android:padding="0dp"
				>
				<tokiokaability.auction.view.ViewPagerCustomDuration
					android:id="@+id/auctionImg"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_alignParentTop="true"
					android:gravity="top"
					android:layout_marginTop="0dp" />
				<com.viewpagerindicator.CirclePageIndicator
					android:id="@+id/indicator"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_alignParentTop="true"
					android:gravity="top"
					/>
			</RelativeLayout>
            <ImageView
                android:id="@+id/imgRank"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitCenter"
                android:src="@drawable/mn_rank"
                />
            <TextView android:id="@+id/txtRank"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:textColor="@android:color/white"
                android:textSize="20dp"
                android:text="AB"
                android:gravity="center"
                />
			<ImageButton
				android:id="@+id/btnSeriVoice"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:layout_alignParentRight="true"
				android:layout_marginTop="20dp"
				android:layout_marginRight="20dp"
				android:background="@null"
				android:contentDescription="@string/auction_title"
				android:scaleType="fitCenter"
				android:src="@drawable/auction_serivoice_on_button_style"
				/>
			<Button android:layout_width="120dp"
				android:layout_height="40dp"
				android:background="@drawable/mn_medium_corner"
				android:layout_marginTop="20dp"
				android:layout_centerHorizontal="true"
				android:text="@string/bid_detail_btn"
				android:textSize="15sp"
				android:textColor="@color/custom_reg_btn_color"
				android:id="@+id/bid_detail_btn"
				android:visibility="gone"
				android:textAllCaps="false"/>
		</RelativeLayout>
		<TextView
			android:id="@+id/lblAbsenceBidPrice"
			android:visibility="visible"
			android:layout_width="wrap_content"
			android:layout_height="23dp"
			android:background="#59ffffff"
			android:layout_marginTop="20dp"
			android:layout_alignParentRight="true"
			android:layout_below="@id/centerView"
			android:layout_marginRight="13dp"
			android:gravity="center_horizontal"
			android:textSize="14dp"
			android:textColor="@android:color/black"
			android:ellipsize="end"/>
		<TextView
			android:id="@+id/lblMemoshort"
			android:visibility="gone"
			android:layout_width="@dimen/_125sdp"
			android:layout_height="23dp"
			android:background="#59ffffff"
			android:layout_marginBottom="-18dp"
			android:layout_alignParentRight="true"
			android:layout_above="@id/lblAbsenceBidPrice"
			android:layout_marginRight="13dp"
			android:gravity="center_vertical|end"
			android:textSize="12dp"
			android:textColor="@android:color/black"
			android:ellipsize="end"
			android:lines="1"/>
		<TextView
			android:ellipsize="end"
			android:lines="1"
			android:id="@+id/lblMemolong"
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="23dp"
			android:background="#59ffffff"
			android:layout_marginLeft="@dimen/_10sdp"
			android:layout_marginBottom="-18dp"
			android:layout_alignParentRight="true"
			android:layout_above="@id/lblAbsenceBidPrice"
			android:layout_marginRight="13dp"
			android:gravity="center_vertical|end"
			android:textSize="12dp"
			android:textColor="@android:color/black"/>
		<View android:layout_width="match_parent"
			android:layout_height="1dp"
			android:id="@+id/centerView"
			android:layout_centerInParent="true"
			android:background="@android:color/transparent"
			/>


		<RelativeLayout
			android:id="@+id/blockActionDetail"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_below="@+id/blockStatus"
			android:layout_alignParentBottom="true"
			android:background="@android:color/transparent"
			>
			<RelativeLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:paddingLeft="13dp"
				android:paddingRight="13dp"
				android:paddingBottom="5dp"
				android:background="@android:color/white">
				<TextView
					android:id="@+id/lblLabelYen"
					android:layout_width="wrap_content"
					android:layout_height="80dp"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="15dp"
					android:layout_marginTop="0dp"
					android:gravity="center"
					android:text="@string/auction_yen"
					android:textColor="@android:color/black"
					android:visibility="gone"
					android:textSize="@dimen/hiragino_large_text_size" />


				<ImageButton android:id="@+id/rateBtn"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:background="@android:color/transparent"
					android:layout_marginTop="8dp"
					android:layout_marginLeft="15dp"
					android:scaleType="fitCenter"
					android:src="@drawable/new_yen"/>


				<TextView
					android:id="@+id/lblCurrentPriceMan"
					android:layout_width="wrap_content"
					android:layout_height="80dp"
					android:layout_alignParentRight="true"
					android:layout_alignBaseline="@+id/lblLabelYen"
					android:layout_marginRight="15dp"
					android:gravity="right|top"
					android:text="99,999,9"
					android:textColor="@android:color/black"
					android:textSize="28dp"/>

				<TextView
				android:id="@+id/lblBrandName"
				android:layout_width="wrap_content"
				android:layout_height="25dp"
				android:layout_alignParentLeft="true"
				android:layout_alignParentTop="true"
				android:layout_marginLeft="@dimen/real_margin_left_item_text"
				android:layout_marginTop="90dp"
				android:maxLines="1"
				android:text="Brand name xxxx xxxx xxxx "
				android:textColor="@android:color/black"
				android:textSize="@dimen/top_content_text_size"
					android:visibility="gone"/>

				<TextView
					android:id="@+id/lblItemName"
					android:layout_width="195dp"
					android:layout_height="wrap_content"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="@dimen/real_margin_left_item_text"
					android:layout_marginTop="50dp"
					android:ellipsize="end"
					android:gravity="center_vertical"
					android:lineSpacingExtra="3dp"
					android:maxLines="1"
					android:text="Item name xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx "
					android:textColor="@android:color/black"
					android:textSize="16dp" />

				<TextView
					android:id="@+id/lblState"
					android:layout_width="195dp"
					android:layout_height="wrap_content"
					android:layout_alignParentLeft="true"
					android:layout_marginLeft="@dimen/real_margin_left_item_text"
					android:layout_below="@+id/lblItemName"
					android:maxLines="1"
					android:text="AB"
					android:gravity="left"
					android:textColor="@android:color/black"
					android:textSize="15dp" />
				<TextView
					android:id="@+id/lblModel"
					android:layout_width="195dp"
					android:layout_height="wrap_content"
					android:layout_alignParentLeft="true"
					android:layout_marginLeft="@dimen/real_margin_left_item_text"
					android:layout_below="@+id/lblState"
					android:layout_alignLeft="@+id/lblState"
					android:maxLines="1"
					android:text="1234567890123456789"
					android:textColor="@android:color/black"
					android:textSize="17dp" />
				<TextView
					android:id="@+id/lblAcc"
					android:layout_width="195dp"
					android:layout_height="wrap_content"
					android:layout_alignParentLeft="true"
					android:layout_marginLeft="@dimen/real_margin_left_item_text"
					android:layout_below="@+id/lblModel"
					android:layout_alignLeft="@+id/lblState"
					android:maxLines="1"
					android:text="1234567890123456789"
					android:textColor="@android:color/black"
					android:textSize="17dp" />

				<Button
					android:id="@+id/btnPush"
					android:layout_width="99dp"
					android:layout_height="99dp"
					android:text="PUSH"
					android:layout_alignParentRight="true"
					android:layout_alignParentTop="true"
					android:layout_marginRight="15dp"
					android:layout_marginTop="45dp"
					android:textColor="@color/mn_btn_push_color"
					android:contentDescription="@string/auction_title"
					android:scaleType="fitCenter"
					android:background="@drawable/mn_btn_push"
					android:textSize="25dp"/>

			</RelativeLayout>



		</RelativeLayout>
		<RelativeLayout
			android:id="@+id/blockStatus"
			android:layout_width="match_parent"
			android:layout_below="@id/centerView"
			android:layout_height="63dp"
			android:background="@android:color/transparent"
			android:paddingLeft="7dp"
			android:layout_marginTop="@dimen/_40sdp"
			>
			<TextView
				android:id="@+id/imvStatusStart"
				android:layout_width="75dp"
				android:layout_height="25dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_start_label"
				android:text="@string/start"
				android:textColor="@android:color/white"
				android:textSize="@dimen/_12sdp"
				android:gravity="center"
				android:contentDescription="@string/auction_title"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"/>

			<ImageView
				android:id="@+id/imvStatusSellOut"
				android:layout_width="75dp"
				android:layout_height="35dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:src="@drawable/auction_status_sellout"
				android:contentDescription="@string/auction_title"
				android:visibility="gone"/>

			<TextView
				android:id="@+id/imvStatusSuccessfullBit"
				android:layout_width="75dp"
				android:layout_height="25dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_winning_label"
				android:text="@string/winning_bid"
				android:textColor="@android:color/white"
				android:textSize="@dimen/_12sdp"
				android:gravity="center"
				android:contentDescription="@string/auction_title"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"
				/>

			<TextView
				android:id="@+id/imvStatusDecide"
				android:layout_width="75dp"
				android:layout_height="25dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_otherbid_label"
				android:text="@string/other_bid"
				android:textColor="@android:color/white"
				android:textSize="@dimen/_12sdp"
				android:gravity="center"
				android:contentDescription="@string/auction_title"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"
				/>

			<TextView
				android:id="@+id/imvStatusHoRyuu"
				android:layout_width="75dp"
				android:layout_height="25dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_onhold_label"
				android:contentDescription="@string/auction_title"
				android:textSize="@dimen/_12sdp"
				android:textColor="@android:color/white"
				android:text="@string/on_hold"
				android:gravity="center"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"
				/>

			<TextView
				android:id="@+id/imvStatusHiki"
				android:layout_width="75dp"
				android:layout_height="25dp"
				android:layout_marginLeft="5dp"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_nobid_label"
				android:text="@string/no_bid"
				android:textColor="@android:color/white"
				android:gravity="center"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"
				android:textSize="@dimen/_12sdp"
				android:contentDescription="@string/auction_title"/>


			<TextView
				android:id="@+id/imvStatusCorrect"
				android:layout_width="63.5dp"
				android:layout_height="wrap_content"
				android:layout_alignParentBottom="true"
				android:layout_alignParentLeft="true"
				android:layout_centerVertical="true"
				android:layout_marginBottom="7dp"
				android:layout_marginLeft="88.5dp"
				android:background="#ffbb33"
				android:contentDescription="@string/auction_title"
				android:gravity="center"
				android:text="@string/correction"
				android:textColor="@android:color/black"
				android:textSize="@dimen/hiragino_button_text_size"
				android:visibility="gone"/>


			<TextView
				android:id="@+id/imvStatusTopBit"
				android:layout_width="55dp"
				android:layout_height="25dp"
				android:layout_marginRight="5dp"
				android:layout_alignParentLeft="true"
				android:layout_marginLeft="85dp"
				android:layout_centerVertical="true"
				android:background="@drawable/custom_topbit_label"
				android:text="@string/bid_right"
				android:textColor="@android:color/white"
				android:gravity="center"
				android:textSize="@dimen/_12sdp"
				android:contentDescription="@string/auction_title"
				android:layout_alignParentBottom="true"
				android:layout_marginBottom="7dp"/>


			<RelativeLayout
				android:layout_width="130dp"
				android:layout_height="match_parent"
				android:layout_alignParentRight="true"
				android:layout_centerVertical="true"
				android:layout_marginRight="13dp"
				android:layout_alignParentTop="true"
				>
				<ImageView
					android:id="@+id/imvLamGreen"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="0dp"
					android:layout_marginTop="4dp"
					android:contentDescription="@string/auction_title"
					android:src="@drawable/auction_lam_green"
					android:visibility="gone"/>

				<ImageView
					android:id="@+id/imvLamYellow"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="29dp"
					android:layout_marginTop="4dp"
					android:contentDescription="@string/auction_title"
					android:src="@drawable/auction_lam_yellow"
					android:visibility="gone"/>

				<ImageView
					android:id="@+id/imvLamRed"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_alignParentLeft="true"
					android:layout_alignParentTop="true"
					android:layout_marginLeft="58dp"
					android:layout_marginTop="4dp"
					android:contentDescription="@string/auction_title"
					android:src="@drawable/auction_lam_red"
					android:visibility="gone"/>
				<TextView
					android:visibility="gone"
					android:id="@+id/lblUnder"
					android:layout_width="55dp"
					android:layout_height="23dp"
					android:background="#cccccc"
					android:layout_marginTop="10dp"
					android:text="@string/bid_under"
					android:gravity="center_horizontal|top"
					android:textSize="14dp"
					android:textColor="@android:color/black"/>
				<TextView
					android:id="@+id/lblOver"
					android:visibility="gone"
					android:layout_width="90dp"
					android:layout_height="23dp"
					android:background="#e6041d"
					android:layout_alignParentBottom="true"
					android:layout_alignParentRight="true"
					android:layout_marginBottom="7dp"
					android:layout_marginRight="10dp"
					android:text="@string/bid_over"
					android:gravity="center_horizontal"
					android:textSize="14dp"
					android:textColor="@android:color/white"/>
				<TextView
					android:id="@+id/lblMemberId"
					android:visibility="gone"
					android:layout_width="match_parent"
					android:layout_marginRight="20dp"
					android:layout_height="30dp"
					android:layout_alignParentBottom="true"
					android:textSize="@dimen/top_content_text_size"
					android:gravity="bottom|right"
					android:textColor="@android:color/black"
					android:paddingBottom="7dp"
					android:text=""/>

			</RelativeLayout>

	</RelativeLayout>
		<TextView
			android:layout_width="match_parent"
			android:layout_height="@dimen/_300sdp"
			android:layout_centerInParent="true"
			android:id="@+id/lblCountdown"
			android:text="1"
			android:autoSizeTextType="uniform"
			android:autoSizeMinTextSize="@dimen/_12sdp"
			android:autoSizeMaxTextSize="@dimen/_177sdp"
			android:autoSizeStepGranularity="2sp"
			android:textColor="#024AA6"
			android:alpha="0.5"
			android:textAlignment="center"
			android:gravity="center"
			android:visibility="visible"
			/>
		<ImageView
			android:layout_width="match_parent"
			android:layout_height="@dimen/_250sdp"
			android:src="@drawable/restback"
			android:layout_marginLeft="@dimen/_50sdp"
			android:layout_marginRight="@dimen/_20sdp"
			android:layout_centerVertical="true"
			android:id="@+id/restBack"
			android:visibility="gone"
			/>
		<LinearLayout
			android:layout_width="@dimen/_200sdp"
			android:layout_height="@dimen/_200sdp"
			android:id="@+id/kyuke"
			android:paddingTop="@dimen/_60sdp"
			android:orientation="vertical"
			android:layout_centerInParent="true"

			android:visibility="gone"
			>
			<TextView
				android:layout_width="match_parent"
				android:layout_height="@dimen/_30sdp"
				android:id="@+id/txtDes1"
				android:textSize="@dimen/_17sdp"
				android:textColor="#000"
				android:text="@string/rest_des1"
				android:gravity="center"
				/>
			<LinearLayout android:id="@+id/restTime"
				android:layout_width="match_parent"
				android:layout_height="@dimen/_30sdp"
				android:orientation="horizontal">
				<TextView
					android:layout_weight="0.5"
					android:layout_height="@dimen/_30sdp"
					android:id="@+id/txtTime"
					android:textSize="@dimen/_15sdp"
					android:textColor="#000"
					android:gravity="center_vertical|right"
					android:layout_width="0dp"
					/>
				<TextView
					android:layout_weight="0.5"
					android:layout_height="@dimen/_30sdp"
					android:id="@+id/rest_des3"
					android:textSize="@dimen/_17sdp"
					android:textColor="#000"
					 android:layout_width="0dp"
					android:paddingLeft="@dimen/_5sdp"
					android:text="@string/rest_time"
					android:gravity="center_vertical|left"/>
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="@dimen/_30sdp"
				android:id="@+id/txtDes2"
				android:textSize="@dimen/_17sdp"
				android:textColor="#000"
				android:text="@string/rest_des2"
				android:gravity="center"
				/>
			<LinearLayout android:id="@+id/restSellNo"
				android:layout_width="match_parent"
				android:layout_height="@dimen/_30sdp"
				android:orientation="horizontal">
				<TextView
					android:layout_width="0dp"
					android:layout_height="@dimen/_30sdp"
					android:id="@+id/rest_des4"
					android:textSize="@dimen/_17sdp"
					android:textColor="#000"
					android:text="@string/rest_sell"
					android:gravity="center_vertical|right"
					android:layout_weight="0.45"
					/>
				<TextView
					android:layout_weight="0.55"
					android:layout_width="0dp"
					android:layout_height="@dimen/_30sdp"
					android:id="@+id/txtSellNo"
					android:textSize="@dimen/_15sdp"
					android:textColor="#000"
					android:paddingLeft="@dimen/_5sdp"
					android:gravity="center_vertical|left"
					/>
			</LinearLayout>

		</LinearLayout>
</RelativeLayout>

