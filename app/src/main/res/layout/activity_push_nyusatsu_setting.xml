<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical"
    android:id="@+id/mainLayout">

    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />


        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/push_nyusatsu_setting_title"
            android:textColor="@android:color/white"
            android:textSize="20sp" />


    </RelativeLayout>

    <TextView android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@+id/blockHeader"
        android:layout_marginTop="50dp"
        android:lineSpacingMultiplier="1.5"
        android:singleLine="false"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:text="@string/push_nyusatsu_setting_Description"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:ellipsize="end"
        android:id="@+id/descriptionTxt"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:id="@+id/chkArea"
        android:layout_below="@id/descriptionTxt">
        <CheckBox
            android:id="@+id/chkPush"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="24dp"
            android:button="@drawable/login_custom_checkbox"
            android:paddingLeft="@dimen/_5sdp"
            android:shadowColor="#00e64d"
            android:text="@string/push_nyusatsu_setting_chk1"
            android:textColor="#000"
            android:textSize="15dp" />
        <CheckBox
            android:id="@+id/chkMail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="36dp"
            android:button="@drawable/login_custom_checkbox"
            android:paddingLeft="@dimen/_5sdp"
            android:shadowColor="#00e64d"
            android:text="@string/push_nyusatsu_setting_chk2"
            android:textColor="#000"
            android:textSize="15dp"
            android:layout_toRightOf="@id/chkPush"/>
        <EditText
            android:id="@+id/txtMail"
            android:layout_width="230dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="15dp"
            android:layout_marginLeft="24dp"
            android:background="@drawable/custom_edittext"
            android:cursorVisible="true"
            android:focusableInTouchMode="true"
            android:gravity="right|center"
            android:hint="@string/register_absence_bid_price_hint"
            android:imeOptions="actionGo"
            android:inputType="text"
            android:paddingRight="8dp"
            android:textColor="#000000"
            android:textSize="@dimen/edittext_content_size">
            <requestFocus />
        </EditText>
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:background="@drawable/custom_blue_white_button"
            android:contentDescription="@string/register_absence_bid_title"
            android:textAllCaps="false"
            android:layout_marginTop="5dp"
            android:text="@string/absence_bid_btn_text"
            android:textSize="@dimen/hiragino_button_text_size"
            android:textColor="@color/custom_white_color"
            android:layout_toRightOf="@+id/txtMail"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="20px"
            >
        </Button>
    </RelativeLayout>
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:layout_below="@+id/chkArea"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="30dp">
        <RadioButton android:layout_width="match_parent"
            android:layout_height="40dp"
            android:id="@+id/btnOK"
            android:text="@string/push_nyusatsu_setting_ok"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            />
        <RadioButton android:layout_width="match_parent"
            android:layout_height="40dp"
            android:id="@+id/btnOkiniri"
            android:text="@string/push_nyusatsu_setting_ok2"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            />
        <RadioButton android:layout_width="match_parent"
            android:layout_height="40dp"
            android:id="@+id/btnDeny"
            android:text="@string/push_nyusatsu_setting_deny"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            />

        <include
            layout="@layout/layout_main_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null" />
    </RadioGroup>
    <ImageButton
        android:id="@+id/btnBit"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/btnBit2"/>
    <ImageButton
        android:id="@+id/btnBit2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style2"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="120dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>