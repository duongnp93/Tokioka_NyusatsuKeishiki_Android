<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:layout_margin="0dp"
    >
    
    <ImageView
        android:id="@+id/imvLaneHeader1"
        android:layout_width="65dp"
        android:layout_height="34dp"
        android:layout_alignParentLeft="true"
        android:src="@drawable/auction_status_lane_header1"        
        />
    
	<ImageView
	    android:id="@+id/imvLaneHeader2"
        android:layout_width="94dp"
        android:layout_height="34dp"
        android:layout_toRightOf="@+id/imvLaneHeader1"
        android:src="@drawable/auction_status_lane_header2"        
        />
        
	<ImageView
	    android:layout_width="match_parent"
	    android:layout_height="34dp"
	    android:layout_toRightOf="@+id/imvLaneHeader2"
	    android:scaleType="fitXY"
	    android:src="@drawable/auction_status_lane_header3" />

	
	<TextView
		android:id="@+id/lblLaneHeader1"
        android:layout_width="65dp"
        android:layout_height="34dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_alignParentLeft="true"
		android:gravity="left|center"
		android:text="@string/auction_status_lane_title"
		android:textColor="@android:color/white"
		android:textSize="16sp" />
	
	<TextView
		android:id="@+id/lblLaneHeader2"
        android:layout_width="94dp"
        android:layout_height="34dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_toRightOf="@+id/lblLaneHeader1"
		android:gravity="left|center"
		android:text="@string/auction_status_product_no"
		android:textColor="@android:color/white"
		android:textSize="16sp" />
	
	<TextView
	    android:layout_width="match_parent"
	    android:layout_height="34dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
	    android:layout_toRightOf="@+id/lblLaneHeader2"
		android:gravity="left|center"
		android:text="@string/auction_status_corner"
		android:textColor="@android:color/white"
		android:textSize="16sp" />
	
</RelativeLayout>