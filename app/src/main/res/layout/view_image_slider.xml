<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <tokiokaability.auction.view.ImageSliderScroll
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:background="@null"
        android:fadingEdge="none"
        >

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal" >


            <ImageView
                android:id="@+id/imgImage2"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitXY"
                android:src="@drawable/auction_no_photo" />


            <ImageView
                android:id="@+id/imgImage1"
                android:layout_marginLeft="10dp"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitXY"
                android:src="@drawable/auction_no_photo" />


            <ImageView
                android:id="@+id/imgImage3"
                android:layout_marginLeft="10dp"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitXY"
                android:src="@drawable/auction_no_photo" />


            <ImageView
                android:id="@+id/imgImage4"
                android:layout_marginLeft="10dp"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitXY"
                android:src="@drawable/auction_no_photo" />


            <ImageView
                android:id="@+id/imgImage5"
                android:layout_marginLeft="10dp"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@null"
                android:contentDescription="@string/auction_title"
                android:scaleType="fitXY"
                android:src="@drawable/auction_no_photo" />


        </LinearLayout>

    </tokiokaability.auction.view.ImageSliderScroll>


    <ImageButton
        android:id="@+id/btnPrev"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="10dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/view_image_slider_arrow_left"/>


    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="10dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/view_image_slider_arrow_right"/>
</RelativeLayout>