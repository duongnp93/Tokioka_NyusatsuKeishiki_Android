<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="33dp"
    android:background="#333333" >
    

        <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="8dp"
                android:layout_height="11.5dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="11dp"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/top_search_previous_button_style" 
                />
        
        <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="8dp"
                android:layout_height="11.5dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="11dp"
                android:background="@null"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/top_search_next_button_style" />        
        

        <tokiokaability.auction.view.ContainerScroll
            android:id="@+id/scroller"
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/btnPrev"
            android:layout_toLeftOf="@+id/btnNext"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:padding="0dp"
            android:background="@null"
            android:fadingEdge="none"
            >


            <LinearLayout
                    android:id="@+id/scrollContent"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:orientation="horizontal" 
                    android:background="#BBBBBB">
                

                        
			</LinearLayout>


        </tokiokaability.auction.view.ContainerScroll>
        
        <View
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/btnPrev"
            android:layout_alignLeft="@+id/scroller"
            android:background="@drawable/view_places_left_mask" />
        
        <View 
            	android:layout_width="10dp"
            	android:layout_height="match_parent"
            	android:layout_toLeftOf="@+id/btnNext"
                android:layout_alignRight="@+id/scroller"
            	android:background="@drawable/view_places_right_mask"
            />
        

    
</RelativeLayout>