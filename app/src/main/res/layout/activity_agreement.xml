<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >
          <ImageButton
              android:id="@+id/btnBack"
              android:layout_width="40dp"
              android:layout_height="25dp"
              android:layout_alignParentLeft="true"
              android:layout_centerVertical="true"
              android:layout_marginLeft="0dp"
              android:background="@null"
              android:contentDescription="@string/app_name"
              android:scaleType="fitCenter"
              android:src="@drawable/common_back_button_style" />
          
          
        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:text="@string/agreement_screen_title"
            android:textSize="20sp"
			/>


    </RelativeLayout>

    <WebView android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/keiyakuArea"
        android:layout_below="@+id/blockHeader"
        android:layout_above="@+id/footerView"
        android:layout_margin="15dp"
        />
    <RelativeLayout android:background="#024AA6"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:id="@+id/footerView">
        <RelativeLayout android:id="@+id/douiArea"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:visibility="visible">
            <ImageView android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:src="@drawable/mn_keiyaku_un"
                android:scaleType="fitCenter"
                android:layout_marginLeft="10dp"
                android:id="@+id/douiImg"/>
            <Button
                android:layout_marginLeft="15dp"
                android:layout_toRightOf="@+id/douiImg"
                android:layout_height="match_parent"
                android:layout_width="wrap_content"
                android:background="@android:color/transparent"
                android:text="@string/agree"
                android:textSize="16sp"
                android:textColor="@color/custom_white_color"
                android:gravity="right|center_vertical"
                android:textAllCaps="false"
                android:paddingRight="10dp"
                android:id="@+id/douiBtn"/>
        </RelativeLayout>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/btnBit"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/btnBit2"/>
    <ImageButton
        android:id="@+id/btnBit2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style2"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="120dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>