<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:background="#ffffff"
    android:orientation="vertical" 
    android:noHistory="true">

	<RelativeLayout
		android:id="@+id/blockHeader"
		android:layout_width="match_parent"
		android:layout_height="40dp"
		android:background="#f77b8f">

		<ImageButton
			android:id="@+id/btnBack"
			android:layout_width="45dp"
			android:layout_height="25dp"
			android:layout_alignParentLeft="true"
			android:layout_centerVertical="true"
			android:layout_marginLeft="0dp"
			android:background="@null"
			android:layout_marginTop="10dp"
			android:contentDescription="@string/app_name"
			android:scaleType="fitCenter"
			android:src="@drawable/common_back_button_style" />

		<TextView
			android:id="@+id/lblScreenTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerInParent="true"
			android:textColor="@android:color/white"
			android:textSize="@dimen/text_header_size"
			android:text="@string/type_search"
			/>

		<ImageButton
			android:visibility="gone"
			android:id="@+id/btnHelp"
			android:layout_width="40dp"
			android:layout_height="25dp"
			android:paddingTop="2dp"
			android:paddingBottom="2dp"
			android:layout_alignParentRight="true"
			android:layout_centerVertical="true"
			android:layout_marginRight="0dp"
			android:layout_marginTop="15dp"
			android:background="@null"
			android:scaleType="fitCenter"
			android:src="@drawable/custom_help_icon"
			android:contentDescription = "LUCE"
			/>

	</RelativeLayout>
	<!--
        <rasis.realluceauction.view.PlacesView
                android:id="@+id/blockPlace"
                android:layout_below="@+id/blockHeader"
                android:layout_width="match_parent"
                android:layout_height="33dp"
                android:layout_alignParentLeft="true"
                android:layout_marginTop="19dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp">
        </rasis.realluceauction.view.PlacesView>
    -->

	<RelativeLayout
		android:id="@+id/blockSearchInput"
		android:layout_width="match_parent"
		android:layout_height="132dp"
		android:layout_centerHorizontal="true"
		android:layout_marginLeft="17.5dp"
		android:layout_marginRight="17.5dp"
		android:layout_marginTop="23dp"
		android:layout_below="@+id/blockHeader"
		android:paddingRight="20dp"
		android:paddingLeft="20dp"
		android:paddingTop="15dp"
		>
		<TextView
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:background="@drawable/custom_corner_textview"
			android:id="@+id/dropdownTxt"
			android:textColor="@android:color/black"
			android:textSize="18dp"
			android:gravity="center_vertical|left"
			android:paddingLeft="20dp"
			/>
		<ImageButton
			android:id="@+id/dropdownBtn"
			android:layout_width="60dp"
			android:layout_height="50dp"
			android:layout_alignParentRight="true"
			android:background="@null"
			android:src="@drawable/spinner_arr_down"
			android:scaleType="fitCenter"
			android:padding="15dp"
			/>



		<EditText
			android:id="@+id/txtFreeword"
			android:layout_width="280dp"
			android:layout_height="50dp"
			android:background="@drawable/search_custom_textbox"
			android:textColor="@android:color/black"
			android:textSize="18dp"
			android:layout_alignParentLeft="true"
			android:layout_alignParentBottom="true"
			android:paddingLeft="20dp"
			android:maxLength="50"
			android:maxLines="1"
			android:paddingRight="55dp"
			android:inputType="text"
			/>
		<ImageButton
			android:id="@+id/btnSearch"
			android:layout_width="60dp"
			android:layout_height="50dp"
			android:layout_alignParentRight="true"
			android:background="@drawable/search_custom_button"
			android:layout_alignParentBottom="true"/>

	</RelativeLayout>

	<ListView
		android:id="@+id/dropdownList"
		android:layout_width="match_parent"
		android:layout_marginLeft="37.5dp"
		android:layout_marginRight="37.5dp"
		android:layout_marginTop="135dp"
		android:layout_height="320dp"
		android:visibility="gone"
		android:scrollbars="none"
		android:divider="@null"
		></ListView>



	<include
        layout="@layout/layout_main_menu"            
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@null"
		android:layout_alignParentBottom="true"/>

</RelativeLayout>