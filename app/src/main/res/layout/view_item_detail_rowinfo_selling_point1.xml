<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:background="@android:color/white"
    >
    <tokiokaability.auction24.commons.HiraginoW3TextView
        android:id="@+id/lblLabel"
        android:layout_width="@dimen/item_detail_label_width"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:layout_marginRight="@dimen/item_detail_table_border"
        android:background="#f2f2f2"
        android:gravity="center_vertical|top"
        android:paddingLeft="@dimen/item_detail_label_padding"
        android:paddingTop="5dp"
        android:text="XXXXX"
        android:textColor="@android:color/black"
        android:textSize="@dimen/item_detail_lable_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/lblLabel"
        android:background="@null"
        android:orientation="vertical"
    >
        <tokiokaability.auction24.commons.HiraginoW3TextView
            android:id="@+id/lblValue1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:background="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="false"
            android:paddingLeft="@dimen/item_detail_label_padding"
            android:textColor="@android:color/black"
            android:textSize="@dimen/item_detail_text_size" />

        <TextView
            android:id="@+id/lblValue2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="@dimen/item_detail_table_border"
            android:background="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="false"
            android:paddingLeft="@dimen/item_detail_label_padding"
            android:textColor="@android:color/black"
            android:textSize="@dimen/item_detail_text_size" />
    </LinearLayout>
    
</LinearLayout>
