<?xml version="1.0" encoding="utf-8"?>

    
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    	android:layout_width="match_parent"
    	android:layout_height="45.5dp"
    	android:layout_marginTop="1dp"
    	android:background="#FFFFFF"
    	android:orientation="vertical" >
    
        	<ImageView 
        	    android:id="@+id/imvChecked"
        	    android:layout_width="16.5dp"
        	    android:layout_height="15.5dp"
        	    android:layout_centerVertical="true"
        	    android:layout_marginLeft="10dp"
        	    android:src="@drawable/common_checked"
        	    android:contentDescription="@string/place_selection_screen_title"
        	    />
        
          	<TextView
                android:id="@+id/lblPlaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/imvChecked"
                android:textColor="#000000"
                android:textSize="20sp" 
                android:background="@null"
                />	
    </RelativeLayout>

