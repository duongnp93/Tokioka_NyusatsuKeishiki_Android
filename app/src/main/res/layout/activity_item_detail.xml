<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/blockWapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true"
    android:background="#f5f5f5"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />

        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/item_detail_screen_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_header_size" />

        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/custom_help_icon"
            android:visibility="gone"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/blockNavi"
        android:layout_width="match_parent"
        android:layout_height="48.5dp"
        android:visibility="visible" >

        <RelativeLayout
            android:id="@+id/blockSubControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" >

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/item_detail_margin"
                android:layout_marginRight="@dimen/item_detail_margin"
                android:background="@null"
                android:contentDescription="@string/app_name"
                android:gravity="center_vertical"
                android:scaleType="fitCenter"
                android:src="@drawable/item_previous_button_style" />

            <TextView
                android:id="@+id/lblSellNo2"
                android:layout_width="match_parent"
                android:layout_height="35dp"

                android:background="@null"
                android:ellipsize="end"
                android:gravity="center_vertical|center_horizontal"
                android:lines="1"
                android:maxLines="1"
                android:textColor="@android:color/black"
                android:textSize="14dp"
                android:text=""
                android:layout_toRightOf="@id/btnPrevious"
                android:layout_toLeftOf="@+id/btnNext"
                />
            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/item_detail_margin"
                android:layout_marginRight="@dimen/item_detail_margin"
                android:background="@null"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/item_next_button_style" />
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:background="@android:color/transparent">
        <ScrollView
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:background="@android:color/transparent"
            android:id="@+id/infoScroll"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">
            <RelativeLayout
                android:id="@+id/tabDetailInfor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                >
                <RelativeLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/imgArea">

                    <tokiokaability.auction.view.ViewPagerCustomDuration
                        android:id="@+id/detailImg"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="0dp" />
                    <com.viewpagerindicator.CirclePageIndicator
                        android:id="@+id/indicator"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_centerHorizontal="true"
                        />
                    <Button android:id="@+id/correctionBtn"
                        android:visibility="gone"
                        android:layout_width="93dp"
                        android:layout_height="25dp"
                        android:background="@drawable/btn_correction_layout"
                        android:layout_marginLeft="27dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/correction_btn"
                        android:textColor="@color/custom_white_color"
                        android:textAllCaps="false"
                        />
                    <ImageButton android:id="@+id/okiniriBtn"
                        android:visibility="visible"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/okiniri"
                        android:layout_marginLeft="30dp"
                        android:layout_marginBottom="20dp"
                        android:scaleType="fitCenter"
                        android:layout_above="@+id/imgLst"/>
                    <TextView
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_alignParentRight="true"
                        android:layout_marginBottom="20dp"
                        android:id="@+id/lblStatus"
                        android:background="@null"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="2sp"
                        android:autoSizeMaxTextSize="15sp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:layout_marginRight="30dp"
                        android:visibility="gone"
                        android:layout_above="@+id/imgLst"
                        />
                    <ImageButton
                        android:id="@+id/btnTradeStatus"
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@null"
                        android:src="@drawable/item_koshoari_button_style"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:scaleType="centerCrop"
                        android:layout_marginBottom="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:visibility="gone"
                        android:layout_above="@+id/imgLst"/>
                    <HorizontalScrollView android:id="@+id/imgLst"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/indicator"
                        android:layout_marginTop="10dp">
                        <LinearLayout android:layout_width="wrap_content"
                            android:layout_height="100dp"
                            android:id="@+id/linearImg"
                            android:orientation="horizontal">
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img1"
                                android:src="@drawable/auction_no_photo"
                                android:tag="0"
                                android:scaleType="fitCenter"
                                />
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img2"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:scaleType="fitCenter"
                                android:tag="1"/>
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img3"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:scaleType="fitCenter"
                                android:tag="2"/>
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img4"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:scaleType="fitCenter"
                                android:tag="3"/>
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img5"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:scaleType="fitCenter"
                                android:tag="4"/>
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img6"
                                android:scaleType="fitCenter"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:tag="5"
                                />
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img7"
                                android:scaleType="fitCenter"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:tag="6"
                                />
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img8"
                                android:scaleType="fitCenter"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:tag="7"
                                />
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img9"
                                android:scaleType="fitCenter"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:tag="8"
                                />
                            <ImageView android:layout_width="100dp"
                                android:layout_height="match_parent"
                                android:id="@+id/img10"
                                android:scaleType="fitCenter"
                                android:src="@drawable/auction_no_photo"
                                android:layout_marginLeft="5dp"
                                android:tag="9"
                                />

                        </LinearLayout>

                    </HorizontalScrollView>
                </RelativeLayout>

                <ListView
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/imgArea"
                    android:id="@+id/lsDetailInfor"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#f5f5f5"
                    android:padding="@dimen/item_detail_table_border"
                    android:dividerHeight="@dimen/item_detail_table_border"
                    android:scrollingCache="false"
                    >
                </ListView>
            </RelativeLayout>
        </ScrollView>
        <ImageButton
            android:id="@+id/btnBit"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:padding="0dp"
            android:src="@drawable/top_search_all_venue_button_style"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="10dp"
            android:layout_marginRight="20dp"
            android:layout_above="@+id/btnBit2"/>
        <ImageButton
            android:id="@+id/btnBit2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:padding="0dp"
            android:src="@drawable/top_search_all_venue_button_style2"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="65dp"
            android:layout_marginRight="20dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>





</LinearLayout>