<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical">
    <include
        layout="@layout/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />


        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:text="@string/language_setting_title"
            android:textSize="20sp"
            />


    </RelativeLayout>

    <TextView
        android:id="@+id/descriptionTxt"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@+id/blockHeader"
        android:layout_marginTop="48dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.5"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:singleLine="false"
        android:text="@string/auc_setting_Description"
        android:textColor="@android:color/black"
        android:textSize="18sp" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:layout_below="@+id/descriptionTxt"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="30dp">
        <RadioButton android:layout_width="match_parent"
            android:layout_height="40dp"
            android:id="@+id/btnOK"
            android:text="@string/auc_setting_ok"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            />
        <RadioButton android:layout_width="match_parent"
            android:layout_height="40dp"
            android:id="@+id/btnDeny"
            android:text="@string/auc_setting_deny"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            />
    </RadioGroup>
    <ImageButton
        android:id="@+id/btnBit"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/btnBit2"/>
    <ImageButton
        android:id="@+id/btnBit2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style2"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="120dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>