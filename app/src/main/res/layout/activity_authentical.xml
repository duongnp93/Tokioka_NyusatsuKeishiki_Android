<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:id="@+id/background">
    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#00e64d" >
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text=""
            android:gravity="center_horizontal|center_vertical"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/top_text_header_size"
            android:id="@+id/txtTitle"
            />
    </RelativeLayout>
    <LinearLayout
        android:layout_below="@+id/blockHeader"
        android:id="@+id/blockBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="290dp"
            android:layout_height="100dp"
            android:src="@drawable/login_banner"/>
        <TextView
            android:id="@+id/txtDescrip1"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Please enter the number received by SMS"
            android:textColor="#000000"
            android:textSize="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="20dp"
            >
            <EditText
                android:id="@+id/txtCode1"
                android:layout_width="50dp"
                android:layout_height="60dp"
                android:background="@drawable/custom_edittext"
                android:layout_gravity="center"
                android:maxLength="1"
                android:textSize="20dp"
                android:lines="1"
                android:gravity="center"
                android:textColor="#000000"
                android:inputType="number"
                />
            <EditText
                android:layout_marginLeft="15dp"
                android:id="@+id/txtCode2"
                android:layout_width="50dp"
                android:layout_height="60dp"
                android:background="@drawable/custom_edittext"
                android:layout_gravity="center"
                android:maxLength="1"
                android:textSize="20dp"
                android:lines="1"
                android:gravity="center"
                android:textColor="#000000"
                android:inputType="number"
                />
            <EditText
                android:layout_marginLeft="15dp"
                android:id="@+id/txtCode3"
                android:layout_width="50dp"
                android:layout_height="60dp"
                android:background="@drawable/custom_edittext"
                android:layout_gravity="center"
                android:maxLength="1"
                android:textSize="20dp"
                android:lines="1"
                android:gravity="center"
                android:textColor="#000000"
                android:inputType="number"
                />
            <EditText
                android:layout_marginLeft="15dp"
                android:id="@+id/txtCode4"
                android:layout_width="50dp"
                android:layout_height="60dp"
                android:background="@drawable/custom_edittext"
                android:layout_gravity="center"
                android:maxLength="1"
                android:textSize="20dp"
                android:lines="1"
                android:gravity="center"
                android:textColor="#000000"
                android:inputType="number"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDescrip2"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="When SMS does not arrive"
            android:textColor="#383838"
            android:textSize="14dp"/>

        <Button
            android:id="@+id/btnResend"
            android:layout_marginTop="5dp"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@null"
            android:text="@string/resend"
            android:textAllCaps="false"
            android:textColor="@color/custom_lightblack_color"
            android:textSize="14dp"
            />
    </LinearLayout>
</RelativeLayout>