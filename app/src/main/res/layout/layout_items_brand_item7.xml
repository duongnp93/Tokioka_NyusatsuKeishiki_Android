<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#999999" >

    <TextView
        android:id="@+id/lblItemNo"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="1dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical|left"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    
	<TextView
        android:id="@+id/lblModelYear"
        android:layout_width="40dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="1dp"
        android:layout_toRightOf="@+id/lblItemNo"
        android:gravity="center_vertical|left"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />
    
    <TextView
        android:id="@+id/lblCarName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="1dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="1dp"
        android:layout_toLeftOf="@+id/lblEval"
        android:layout_toRightOf="@+id/lblModelYear"
        android:gravity="center_vertical|left"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblEval"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="1dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical|left"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblPlaceName"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/lblItemNo"
        android:layout_marginBottom="1dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:gravity="center_vertical|left"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblGradeName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_below="@+id/lblModelYear"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:layout_toLeftOf="@+id/lblModel"
        android:layout_toRightOf="@+id/lblPlaceName"
        android:gravity="center_vertical|left"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblModel"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_toLeftOf="@+id/lblDisplacement"
        android:layout_below="@+id/lblCarName"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:gravity="center_vertical|left"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblDisplacement"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/lblEval"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:gravity="center_vertical|right"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    <TextView
        android:id="@+id/lblHoldDate"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentLeft="true"
        android:layout_below="@+id/lblPlaceName"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        android:gravity="center_vertical|left"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    
    <TextView
        android:id="@+id/lblColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_below="@+id/lblGradeName"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:layout_toLeftOf="@+id/lblDistance"
        android:layout_toRightOf="@+id/lblHoldDate"
        android:gravity="center_vertical|left"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

    
    
    <TextView
        android:id="@+id/lblDistance"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_below="@+id/lblModel"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:layout_toLeftOf="@+id/lblLastPrice"
        android:gravity="center_vertical|right"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" >
    </TextView>

    <TextView
        android:id="@+id/lblLastPrice"
        android:layout_width="78dp"
        android:layout_height="@dimen/items_info_textview_height"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/lblDisplacement"
        android:layout_marginBottom="1dp"
        android:layout_marginTop="0dp"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="1dp"
        android:gravity="center_vertical|right"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:lines="1"
        android:maxLines="1"
        android:textColor="#000000"
        android:textSize="@dimen/items_info_text_size" />

</RelativeLayout>