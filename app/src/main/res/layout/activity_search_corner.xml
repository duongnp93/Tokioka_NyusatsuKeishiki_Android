<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    android:background="#f2f2f2"
    android:orientation="vertical" 
    android:noHistory="true">

    <RelativeLayout
        android:id="@+id/blockHeader"
     	android:layout_width="match_parent"
     	android:layout_height="40dp"
     	android:background="#f77b8f">
     	
		<ImageButton
		    android:id="@+id/btnBack"
		    android:layout_width="45dp"
		    android:layout_height="25dp"
		    android:layout_alignParentLeft="true"
		    android:layout_centerVertical="true"
		    android:layout_marginLeft="10dp"
		    android:background="@null"
		    android:contentDescription="@string/app_name"
		    android:scaleType="fitCenter"
		    android:src="@drawable/common_back_button_style" />
        
       <TextView 
           android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/corner_search_screen_title"/>
        
    </RelativeLayout>

<!--
    <rasis.realluceauction.view.PlacesView
            android:id="@+id/blockPlace"
            android:layout_below="@+id/blockHeader"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="19dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
    </rasis.realluceauction.view.PlacesView>
-->
	<ListView
	    android:id="@+id/lvCornerList"
	    android:layout_width="match_parent"
	    android:layout_height="match_parent"
	    android:layout_below="@+id/blockHeader"
	    android:layout_centerHorizontal="true"
	    android:layout_marginBottom="55dp"
	    android:layout_marginLeft="10dp"
	    android:layout_marginRight="10dp"
	    android:layout_marginTop="23dp"
	    android:divider="@null"
	    android:drawSelectorOnTop="true"
	    android:listSelector="@drawable/list_selector"
	    android:dividerHeight="0dp"
	    android:padding="0dp"
		android:background="@android:color/white">

    </ListView>
    
    
    
    <include 
        layout="@layout/layout_main_menu"            
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@null"
		android:layout_alignParentBottom="true"/>

</RelativeLayout>