<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@null" >
   
    <RelativeLayout
        android:id="@+id/blockMainMenu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="0dp"
        android:background="#fcfcfc" >

        <LinearLayout
        	android:layout_width="wrap_content"
        	android:layout_height="match_parent"
        	android:layout_centerInParent="true"
        	android:weightSum="1.0"

        	>

			<ImageButton
				android:id="@+id/btnMainMenuSearch"
				android:layout_width="90dp"
				android:layout_height="40dp"
				android:layout_marginTop="5dp"
				android:layout_weight="0.25"
				android:background="@null"
				android:contentDescription="@string/app_name"
				android:scaleType="fitCenter"
				android:src="@drawable/mn_home"
				/>
			<ImageButton
				android:id="@+id/btnMainMenuList"
				android:src="@drawable/mn_search"
				android:background="@null"
				android:layout_height="40dp"
				android:layout_width="90dp"
				android:scaleType="fitCenter"
				android:contentDescription="@string/app_name"
				android:layout_weight="0.25"
				android:layout_marginTop="5dp"
				/>

	        <ImageButton             
	            android:id="@+id/btnMainMenuBit" 
	            android:src="@drawable/mn_auc"
	            android:background="@null"
				android:layout_height="40dp"
				android:layout_width="90dp"
	            android:scaleType="fitCenter"
	            android:contentDescription="@string/app_name"
	            android:layout_weight="0.25"
				android:layout_marginTop="5dp"
	            />
	                


			<!--
	       	<ImageButton             
	            android:id="@+id/btnMainMenuRate" 
	            android:src="@drawable/menu_rate_button"
	            android:background="@null"
				android:layout_height="55dp"
				android:layout_width="72dp"
	            android:scaleType="fitCenter"
	            android:contentDescription="@string/app_name"
	            android:layout_weight="0.2"
	            />
	        -->

	            
	        <ImageButton             
	            android:id="@+id/btnMainMenuSetting" 
	            android:src="@drawable/mn_setting"
	            android:background="@null"
				android:layout_height="40dp"
				android:layout_width="90dp"
	            android:scaleType="fitCenter"
	            android:contentDescription="@string/app_name"
	            android:layout_weight="0.25"
				android:layout_marginTop="5dp"
	            />
	     </LinearLayout>
    </RelativeLayout>

</RelativeLayout>