<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    >
    <ImageButton android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/closebtn_bid"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:id="@+id/closeBtn"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"/>
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@drawable/custom_corner_textview"
        android:layout_below="@+id/closeBtn"
        android:id="@+id/formBgr"
        android:layout_marginBottom="30dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="325dp"
            android:layout_below="@id/imgWon"
            android:layout_marginTop="-60dp"
            android:id="@+id/imgShuppin"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:scaleType="fitStart"/>
        <ImageView android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mn_won"
            android:id="@+id/imgWon"
            android:background="@android:color/transparent"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:id="@+id/centerView"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            />
        <TextView android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:id="@+id/brandTxt"
            android:layout_below="@+id/centerView"
            android:layout_marginTop="@dimen/_80sdp"
            android:paddingLeft="30dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_16sdp"
            android:gravity="top|left"
            android:singleLine="true"
            />
        <TextView android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:id="@+id/ModelTxt"
            android:layout_below="@+id/brandTxt"
            android:paddingLeft="30dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_16sdp"
            android:gravity="top|left"
            android:singleLine="true"
            />
        <TextView android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:id="@+id/SerialTxt"
            android:layout_below="@+id/ModelTxt"
            android:paddingLeft="30dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_16sdp"
            android:gravity="top|left"
            android:singleLine="true"
            />
        <TextView android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:id="@+id/AccTxt"
            android:layout_below="@+id/SerialTxt"
            android:paddingLeft="30dp"
            android:textColor="@android:color/black"
            android:textSize="@dimen/_16sdp"
            android:gravity="top|left"
            android:singleLine="true"
            />
        <TextView android:layout_width="match_parent"
            android:layout_height="60dp"
            android:id="@+id/PriceTxt"
            android:paddingLeft="30dp"
            android:textColor="@android:color/black"
            android:textSize="26dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical|right"
            android:paddingRight="20dp"
            />

    </RelativeLayout>

</RelativeLayout>