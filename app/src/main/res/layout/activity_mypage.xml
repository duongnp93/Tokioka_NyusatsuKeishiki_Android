<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical">
    <include
        layout="@layout/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />
    <RelativeLayout
        android:layout_below="@id/statusBar"
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />


        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:text="@string/mypage_title"
            android:textSize="20sp"
            />


    </RelativeLayout>

    <TextView
        android:id="@+id/descriptionTxt"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@+id/blockHeader"
        android:layout_marginTop="48dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.5"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:singleLine="false"
        android:text="@string/mypage_descrip"
        android:textColor="@android:color/black"
        android:textSize="18sp" />

    <RelativeLayout
        android:id="@+id/kaisaibiSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/descriptionTxt"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20sp">


        <TextView
            android:id="@+id/kaisaibiSearchTxt"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/custom_border_textbox"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:text=""
            android:textColor="@android:color/black" />

        <ImageButton
            android:id="@+id/selectBtn"
            android:layout_width="39dp"
            android:layout_height="28dp"
            android:layout_marginLeft="-40dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/kaisaibiSearchTxt"
            android:background="@null"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/spinner_arr_down" />

    </RelativeLayout>

    <TextView
        android:id="@+id/seisanLink"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="70dp"
        android:background="@null"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text="@string/mypage_seisan"
        android:textColor="#024AA6"
        android:layout_below="@+id/kaisaibiSearchLayout"
        android:visibility="invisible"/>

    <ImageButton
        android:id="@+id/btnBit"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/btnBit2"/>
    <ImageButton
        android:id="@+id/btnBit2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style2"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="120dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"/>
    <ListView
        android:id="@+id/kaisaibiList"
        android:layout_width="150dp"
        android:layout_height="166dp"
        android:layout_below="@id/kaisaibiSearchLayout"
        android:layout_marginTop="-2dp"
        android:layout_marginLeft="30dp"
        android:divider="@null"
        android:focusableInTouchMode="false"
        android:focusable="false"
        android:visibility="gone">
    </ListView>

</RelativeLayout>