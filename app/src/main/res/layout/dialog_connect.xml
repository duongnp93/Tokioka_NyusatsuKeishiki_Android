<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="200dp"
    android:background="@android:color/black" >
    
		<TextView
		    android:id="@+id/lblScreenTitle"
		    android:layout_width="wrap_content"
		    android:layout_height="30dp"
		    android:layout_centerHorizontal="true"
		    android:layout_marginTop="10dp"
		    android:gravity="center_vertical"
		    android:text="@string/connection_title"
		    android:textColor="@android:color/white"
		    android:textSize="20sp" />

		<TextView
		    android:id="@+id/lblLabelConfirm"
		    android:layout_width="wrap_content"
		    android:layout_height="30dp"
		    android:layout_below="@+id/lblScreenTitle"
		    android:layout_centerHorizontal="true"
		    android:layout_marginTop="15dp"
		    android:gravity="center_vertical"
		    android:text="@string/connection_confirm_reconnect"
		    android:textColor="@android:color/white"
		    android:textSize="16sp" />
		
		<ProgressBar
		    android:id="@+id/pgbIndicator"
		    android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
		    android:layout_alignParentLeft="true"
		    android:layout_centerHorizontal="true"
		    android:layout_marginLeft="70dp"
		    android:layout_marginTop="50dp" />
		
		<TextView
		    android:id="@+id/lblLabelConnecting"
		    android:layout_width="wrap_content"
		    android:layout_height="30dp"
		    android:layout_alignParentRight="true"
		    android:layout_marginLeft="5dp"
		    android:layout_marginTop="55dp"
		    android:layout_toRightOf="@+id/pgbIndicator"
		    android:gravity="center_vertical"
		    android:text="@string/connection_connecting"
		    android:textColor="@android:color/white"
		    android:textSize="16sp" />
		
			<Button
			    android:id="@+id/btnBack"
			    android:layout_width="100dp"
			    android:layout_height="47dp"
			    android:layout_alignParentLeft="true"
			    android:layout_marginLeft="30dp"
			    android:layout_marginTop="130dp"
			    android:background="@drawable/button_normal_style"
			    android:contentDescription="@string/connection_title"
			    android:duplicateParentState="false"
			    android:focusableInTouchMode="false"
			    android:scaleType="fitCenter"
			    android:text="@string/connection_back"
			    android:textColor="@android:color/white"
			    android:textSize="18sp" />
		
			<Button
			    android:id="@+id/btnConnect"
			    android:layout_width="100dp"
			    android:layout_height="47dp"
			    android:layout_alignParentRight="true"
			    android:layout_marginRight="30dp"
			    android:layout_marginTop="130dp"
			    android:background="@drawable/button_normal_style"
			    android:contentDescription="@string/connection_title"
			    android:duplicateParentState="false"
			    android:focusableInTouchMode="false"
			    android:scaleType="fitCenter"
			    android:text="@string/connection_connect"
			    android:textColor="@android:color/white"
			    android:textSize="18sp" />
			
			
			
</RelativeLayout>