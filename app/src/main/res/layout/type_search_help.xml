<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">
    <tokiokaability.auction24.view.HiraginoW6TextView
        android:id="@+id/titleTxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal|center_vertical"
        android:textSize="@dimen/top_text_header_size"
        android:textColor="#006666"
        android:text="@string/type_help_title"/>

    <tokiokaability.auction24.commons.HiraginoW3TextView
        android:id="@+id/descriptionTxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|left"
        android:textSize="@dimen/top_content_text_size"
        android:text="@string/type_help_des"
        android:paddingLeft="20dp"
        android:paddingRight="30dp"
        android:textColor="@android:color/black"
        android:lineSpacingExtra="7dp"/>
    <tokiokaability.auction24.view.HiraginoW6TextView
        android:id="@+id/listTxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:textSize="@dimen/top_content_text_size"
        android:paddingLeft="20dp"
        android:paddingRight="30dp"
        android:gravity="top|left"
        android:textColor="@android:color/black"
        android:text="@string/type_help_list"
        android:lineSpacingExtra="10dp"/>
</LinearLayout>