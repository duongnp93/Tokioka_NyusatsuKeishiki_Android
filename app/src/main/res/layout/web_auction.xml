<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />
    <RelativeLayout
        android:layout_below="@id/statusBar"
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />


        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_header_size" />

        <ImageButton
            android:visibility="gone"
            android:id="@+id/btnHelp"
            android:layout_width="40dp"
            android:layout_height="25dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/custom_help_icon" />
    </RelativeLayout>
    <WebView android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/webViewArea"
        android:layout_margin="0dp"
        android:layout_below="@+id/blockHeader"
        />
    <ImageButton
        android:id="@+id/btnBit"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="10dp"
        android:layout_marginRight="20dp"
        android:layout_above="@+id/btnBit2"/>
    <ImageButton
        android:id="@+id/btnBit2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@null"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:padding="0dp"
        android:src="@drawable/top_search_all_venue_button_style2"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="65dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>