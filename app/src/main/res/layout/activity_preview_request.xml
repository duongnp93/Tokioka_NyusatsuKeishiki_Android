<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#333333"
    android:duplicateParentState="false"
    android:noHistory="true"
    android:orientation="vertical" >

    <RelativeLayout
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="48.5dp"
        android:background="@drawable/common_bar_bg" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />

        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="36dp"
            android:layout_marginRight="@dimen/item_detail_margin"
            android:gravity="center_horizontal"
            android:layout_toLeftOf="@+id/btnBack"
            android:text="@string/register_preview_request_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/preview_request_title" />

        <!-- <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="51.5dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_help_button_style" /> -->
    </RelativeLayout>

