<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#333333">
    
    <RelativeLayout
        android:id="@+id/blockHeader"
     	android:layout_width="match_parent"
     	android:layout_height="48.5dp"
     	android:background="@drawable/common_bar_bg">
     	
		<ImageButton
		    android:id="@+id/btnBack"
		    android:layout_width="56dp"
		    android:layout_height="36dp"
		    android:layout_alignParentLeft="true"
		    android:layout_centerVertical="true"
		    android:layout_marginLeft="10dp"
		    android:background="@null"
		    android:contentDescription="@string/app_name"
		    android:scaleType="fitCenter"
		    android:src="@drawable/common_back_button_style" />
        
       <TextView 
           android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:text="@string/auction_status_screen_title"/>
        
        <ImageButton
            android:id="@+id/btnUpdate"
            android:layout_width="82dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:background="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/place_update_button_style" 
            android:contentDescription = "@string/auction_status_screen_title"
            />
    </RelativeLayout>
    
    
    <ListView
        android:id="@+id/lvPlaceInfoList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#333333"
        android:layout_marginBottom="55dp"
        android:dividerHeight="0dp"
        android:divider="@null"
        android:padding="0dp"
        android:layout_below="@+id/blockHeader">
    </ListView>
     
    
    
	<include 
        layout="@layout/layout_main_menu"            
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@null"
		android:layout_alignParentBottom="true"/>
</RelativeLayout>