<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contactLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:duplicateParentState="false"
    android:noHistory="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"></LinearLayout>
    <View
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />
    <RelativeLayout
        android:layout_below="@id/statusBar"
        android:id="@+id/blockHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#024AA6">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/common_back_button_style" />

        <TextView
            android:id="@+id/lblScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/contact_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/top_text_header_size" />

        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="0dp"
            android:background="@null"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/custom_help_icon"
            android:visibility="gone" />
    </RelativeLayout>

    <TextView
        android:id="@+id/lblBoxNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/blockHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/blockHeader"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="80dp"
        android:text="@string/contact_inquiry_details"
        android:textColor="@android:color/black"
        android:textSize="15sp" />

    <RelativeLayout
        android:id="@+id/blockInquiryForm"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_below="@id/lblContact"
        android:layout_centerInParent="false"
        android:paddingLeft="5dp"
        android:paddingRight="20dp">

        <EditText
            android:id="@+id/txtContact"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="15dp"
            android:background="@drawable/custom_border_textbox_black"
            android:cursorVisible="true"
            android:focusableInTouchMode="true"
            android:gravity="left"
            android:imeOptions="actionGo"
            android:maxLength="500"
            android:paddingLeft="5dp"
            android:paddingTop="5dp"
            android:paddingRight="5dp"
            android:paddingBottom="5dp"
            android:password="false"
            android:phoneNumber="false"
            android:selectAllOnFocus="false"
            android:singleLine="false"
            android:textColor="#000000"
            android:textSize="@dimen/edittext_content_size">

            <requestFocus />
        </EditText>

    </RelativeLayout>

    <TextView
        android:id="@+id/lblNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/blockInquiryForm"
        android:layout_marginLeft="20dp"
        android:text="@string/contact_note"
        android:textColor="#000000"
        android:textSize="12sp" />

    <RelativeLayout
        android:id="@+id/blockCommand"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/lblNote"
        android:layout_centerInParent="false"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="45dp">

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp"
            android:background="@drawable/mn_greenbutton"
            android:contentDescription="@string/register_absence_bid_title"
            android:text="@string/contact_submit"
            android:textAllCaps="false"
            android:textColor="@color/mn_green"
            android:textSize="@dimen/hiragino_button_text_size"></Button>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/mn_greenbutton"
            android:contentDescription="@string/register_absence_bid_title"
            android:scaleType="fitCenter"
            android:text="@string/contact_back"
            android:textAllCaps="false"
            android:textColor="@color/mn_green"
            android:textSize="@dimen/hiragino_button_text_size"></Button>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/blockLblAnswer"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_below="@id/blockCommand"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp">

        <TextView
            android:id="@+id/lblAnswer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/contact_answer_details"
            android:textColor="@android:color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lblUpdateDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_toRightOf="@id/lblAnswer"
            android:gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lblUpdateDateValue"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_toRightOf="@id/lblUpdateDate"
            android:gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textSize="13sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/blockAnswerForm"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_below="@id/blockLblAnswer"
        android:paddingLeft="5dp"
        android:paddingRight="20dp">

        <EditText
            android:id="@+id/txtAnswer"

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="15dp"
            android:background="@drawable/custom_border_uneditable_textbox_black"
            android:cursorVisible="true"
            android:editable="false"
            android:focusableInTouchMode="true"
            android:gravity="left"
            android:hint="@string/register_absence_bid_price_hint"
            android:imeOptions="actionGo"
            android:paddingLeft="5dp"
            android:paddingTop="5dp"
            android:paddingRight="5dp"
            android:paddingBottom="5dp"
            android:password="false"
            android:phoneNumber="false"
            android:selectAllOnFocus="false"
            android:singleLine="false"
            android:textColor="#000000"
            android:textSize="@dimen/edittext_content_size">

            <requestFocus />
        </EditText>

    </RelativeLayout>

    <TextView
        android:id="@+id/lblTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/blockAnswerForm"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

</RelativeLayout>