<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dip"/>
                    <solid android:color="#ffffff"/>
                    <padding android:top="3dp" android:left="3dp" android:bottom="3dp" android:right="3dp"/>
                </shape>
            </item>

            <item android:top="20dp" android:right="12dp" android:bottom="20dp">
                <bitmap android:src="@drawable/spinner_arr_down" android:gravity="center|right"/>
            </item>
        </layer-list>
    </item>
</selector>